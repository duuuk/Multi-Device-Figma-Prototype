{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": false,
    "sourceMap": false,
    "types": ["@figma/plugin-typings"]
  },
  "include": ["src/sandbox/**/*.ts", "src/shared/**/*.ts"],
  "exclude": ["node_modules", "dist", "src/ui/**/*"]
}
